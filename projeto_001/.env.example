# Copie para .env e preencha. O mesmo arquivo serve para o dev local e para o docker compose.
# Valores do projeto em supabase.com → Project Settings → API Keys.

# --- Supabase (servidor: apps/realtime) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# SÓ SERVIDOR. Ignora RLS. Nunca usar em código client nem com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Chaves públicas para validar o JWT do Supabase Auth.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Web (apps/web). Variáveis NEXT_PUBLIC_ vão para o bundle do navegador e são fixadas no build. ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Em dev: http://localhost:4000. Atrás do Caddy: a mesma origem do site (ex.: https://localhost).
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# --- Realtime (apps/realtime) ---
REALTIME_PORT=4000
# Origem permitida no CORS do Socket.IO (URL pública da web).
WEB_ORIGIN=http://localhost:3000

# --- Infra (Caddy) ---
# Domínio público. "localhost" usa certificado interno do Caddy.
SITE_ADDRESS=localhost
