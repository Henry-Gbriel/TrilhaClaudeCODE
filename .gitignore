# Vale para todos os projetos do repositório (projeto_000, projeto_001, ...).

# --- Segredos e variáveis de ambiente ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.npmrc

# --- Dependências ---
node_modules/
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build e caches ---
dist/
build/
out/
.next/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
.eslintcache
.cache/

# --- Testes ---
coverage/
playwright-report/
test-results/
blob-report/
